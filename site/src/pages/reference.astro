---
// The API reference: Scalar over the published contract. Both the contract
// and the Scalar bundle are copied into public/ by scripts/sync-contract.mjs,
// so the page loads nothing from another host.
import { ScalarComponent } from '@scalar/astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'API reference | mdmsdk';
const description = 'Every operation of the mdm API an account client or a delegated token can call.';

const customCss = `
:root {
  --scalar-custom-header-height: 3rem;
  --scalar-font: system-ui, -apple-system, 'Segoe UI', sans-serif;
  --scalar-font-code: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --scalar-radius: 4px;
  --scalar-radius-lg: 6px;
}
.light-mode {
  --scalar-background-1: oklch(0.985 0.004 75);
  --scalar-background-2: oklch(0.965 0.006 75);
  --scalar-background-3: oklch(0.94 0.007 75);
  --scalar-color-1: oklch(0.22 0.012 75);
  --scalar-color-2: oklch(0.47 0.012 75);
  --scalar-color-3: oklch(0.5 0.012 75);
  --scalar-color-accent: oklch(0.51 0.27 264);
  --scalar-background-accent: oklch(0.95 0.03 264);
  --scalar-border-color: oklch(0.9 0.008 75);
}
.dark-mode {
  --scalar-background-1: oklch(0.19 0.006 75);
  --scalar-background-2: oklch(0.225 0.007 75);
  --scalar-background-3: oklch(0.29 0.008 75);
  --scalar-color-1: oklch(0.965 0.004 75);
  --scalar-color-2: oklch(0.84 0.008 75);
  --scalar-color-3: oklch(0.68 0.01 75);
  --scalar-color-accent: oklch(0.82 0.1 264);
  --scalar-background-accent: oklch(0.3 0.1 264);
  --scalar-border-color: oklch(0.29 0.008 75);
}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(`${base}/reference/`, Astro.site)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <header class="bar">
      <a class="home" href={`${base}/`}>mdmsdk</a>
      <nav aria-label="Docs">
        <a href={`${base}/quickstart/`}>Quickstart</a>
        <a href={`${base}/guides/errors/`}>Errors</a>
        <a href={`${base}/openapi.yaml`}>openapi.yaml</a>
      </nav>
    </header>
    <main>
      <ScalarComponent
        renderMode="client"
        configuration={{
          url: `${base}/openapi.yaml`,
          cdn: `${base}/scalar/standalone.js`,
          theme: 'none',
          customCss,
          withDefaultFonts: false,
          // The API serves a browser origin only for a delegated token whose
          // account registered it, so a request sent from this page would fail.
          hideTestRequestButton: true,
          hideClientButton: true,
          showDeveloperTools: 'never',
          agent: { disabled: true },
          mcp: { disabled: true },
          telemetry: false,
        }}
      />
      <noscript>
        <p class="fallback">
          The reference needs JavaScript. The contract itself is at <a href={`${base}/openapi.yaml`}>openapi.yaml</a>.
        </p>
      </noscript>
    </main>
    <script is:inline>
      // Open in the theme the docs were last read in. Classic inline scripts
      // run before the deferred module that mounts Scalar.
      (() => {
        const el = document.querySelector('[data-scalar-client]');
        if (!el) return;
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') ?? '';
        } catch {
          // Storage can be blocked; the system preference still applies.
        }
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        const config = JSON.parse(el.dataset.configuration ?? '{}');
        el.dataset.configuration = JSON.stringify({ ...config, darkMode: dark });
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --bar-bg: oklch(0.975 0.005 75);
    --bar-rule: oklch(0.9 0.008 75);
    --bar-ink: oklch(0.22 0.012 75);
    --bar-muted: oklch(0.47 0.012 75);
    --page-bg: oklch(0.985 0.004 75);
    --focus: oklch(0.51 0.27 264);
  }
  :root[data-theme='dark'] {
    --bar-bg: oklch(0.225 0.007 75);
    --bar-rule: oklch(0.29 0.008 75);
    --bar-ink: oklch(0.965 0.004 75);
    --bar-muted: oklch(0.84 0.008 75);
    --page-bg: oklch(0.19 0.006 75);
    --focus: oklch(0.82 0.1 264);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --bar-bg: oklch(0.225 0.007 75);
      --bar-rule: oklch(0.29 0.008 75);
      --bar-ink: oklch(0.965 0.004 75);
      --bar-muted: oklch(0.84 0.008 75);
      --page-bg: oklch(0.19 0.006 75);
      --focus: oklch(0.82 0.1 264);
    }
  }
  body {
    margin: 0;
    background: var(--page-bg);
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 100;
    box-sizing: border-box;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 1rem;
    background: var(--bar-bg);
    border-bottom: 1px solid var(--bar-rule);
    font-size: 0.875rem;
  }
  .bar a {
    color: var(--bar-muted);
    text-decoration: none;
    border-radius: 4px;
  }
  .bar a:hover {
    color: var(--bar-ink);
    text-decoration: underline;
  }
  .bar a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .bar .home {
    color: var(--bar-ink);
    font-weight: 600;
    font-size: 1rem;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  .fallback {
    max-width: 40rem;
    margin: 3rem auto;
    padding-inline: 1rem;
    color: var(--bar-ink);
  }
</style>
